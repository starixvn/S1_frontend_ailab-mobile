pipeline {
    agent any
    tools {nodejs "nodejs"}
    environment{
        node_modules_exists = fileExists 'node_modules'
        auto_deploy = fileExists 'deploy.yml'
    }
    stages {
        stage('Install dependencies') {
            when {
                anyOf {
                    changeset "package.json"
                    expression { node_modules_exists == 'false' }
                }
            }
            steps {
                sh 'npm install'
            }
        }
        stage('Build') {
            steps {
                sh '(git rev-parse --short=7 HEAD & git rev-parse --abbrev-ref HEAD) > apps/bwing/public/rnt.txt'
                sh 'npx nx autobuild bwing --skip-nx-cache'
            }
        }
        stage('Zip'){
            steps {
                dir("dist/apps/bwing"){
                    script {
                        env.commitHash = sh (script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                    }
                    sh 'zip -r mobile-bwing-${commitHash} *'
                    sh 'curl -v -u admin:123456 --upload-file mobile-bwing-${commitHash}.zip http://172.31.28.233:8081/repository/artifacts/Frontend/mobile/bwing/mobile-bwing-${commitHash}.zip'
                    sh 'echo mobile-bwing-${commitHash}'
                }
            }
        }
        stage('Deploy') {
            when {
                expression { auto_deploy == 'true' }
            }
            steps {
                sh 'ansible-playbook -i Dev.yml deploy.yml --extra-vars "commitId=${commitHash} site=bwing platform=mobile host=mobile-bwing"'
            }
        }
    }
}