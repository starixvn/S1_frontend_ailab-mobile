pipeline {
    agent any
    tools {nodejs "nodejs"}
    environment{
        node_modules_exists = fileExists 'node_modules'
        site = 'leobet'
        project_name = 'leobet'
        env = 'dev'
        ansible_path = '/var/jenkins_home/ansible/frontend/'
    }
    stages {
        stage('多線程處理') {
            // 多線程處理兩個 build
            parallel{
                stage("Start"){
                    stages {
                        stage('Install dependencies') {
                            when {
                                anyOf {
                                    changeset "package.json"
                                    expression { node_modules_exists == 'false' }
                                }
                            }
                            steps {
                                sh 'npm i --force'
                            }
                    }
                        stage('Build') {
                            steps {
                                sh '(git rev-parse --short=7 HEAD & git rev-parse --abbrev-ref HEAD) > apps/${project_name}/public/rnt.txt'
                                sh 'npx nx autobuild ${project_name} --skip-nx-cache'
                            }
                        }
                        stage('Zip'){
                            steps {
                                dir("dist/apps/${project_name}"){
                                    script {
                                        env.commitHash = sh (script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                                    }
                                    sh 'zip -r mobile-${site}-${commitHash} *'
                                    sh 'curl -v -u admin:123456 --upload-file mobile-${site}-${commitHash}.zip http://172.31.28.169:8081/repository/artifacts/Frontend/mobile/${site}/${env}/mobile-${site}-${commitHash}.zip'
                                    sh 'echo mobile-${site}-${commitHash}'
                                }
                            }
                        }
                        stage('Deploy') {
                            steps {
                                sh 'ansible-playbook -i ${ansible_path}host.yml ${ansible_path}deploy.yml --extra-vars "commitId=${commitHash} site=${site} platform=mobile host=mobile-${site} env=${env}"'
                        }
                        }
                    }
                }
            }
        }
    }
}


