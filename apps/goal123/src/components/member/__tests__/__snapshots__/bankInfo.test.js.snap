exports[`Bank info has account name renders correctly 1`] = `
Array [
  <div
    className="avatar"
  />,
  <div
    className="name"
    data-testid="accountName"
  >
    qaq
  </div>,
  <div
    className="text-org"
    data-testid="accountNameTip"
  >
    For any request of modification, please contact CSD.
  </div>,
  <div
    className="btn-group"
    data-testid="addAccountBtn"
  >
    <button
      className="orange"
      onClick={[Function]}
    >
      <i
        className="icon icon-user-plus"
      />
      Add New Account
    </button>
  </div>,
  <div
    className="bankAccount"
    data-testid="accountList"
  />,
]
`;

