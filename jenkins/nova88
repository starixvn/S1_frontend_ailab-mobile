pipeline {
    agent any
    tools {nodejs "nodejs"}
    stages {
        stage('Install dependencies') {
            when {
                changeset "package.json"
            }
            steps {
                sh 'npm install'
            }
        }
        stage('Build') {
            steps {
                sh '(git rev-parse HEAD & git rev-parse --abbrev-ref HEAD) > apps/nova88v2/public/rnt.txt'
                sh 'npx nx build nova88v2 --skip-nx-cache'
            }
        }
        stage('Zip'){
            steps {
                dir("dist/apps/nova88v2"){
                    script {
                        env.commitHash = sh (script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    }
                    sh 'zip -r mobile-nova88-${commitHash} *'
                    sh 'curl -v -u admin:123456 --upload-file mobile-nova88-${commitHash}.zip http://172.31.28.233:8081/repository/artifacts/Frontend/mobile-nova88-${commitHash}.zip'
                    sh 'echo mobile-nova88-${commitHash}'
                }
            }
        }
    }
}