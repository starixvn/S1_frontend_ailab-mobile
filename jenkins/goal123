pipeline {
    agent any
    tools {nodejs "nodejs"}
    stages {
        stage('Install dependencies') {
            when {
                changeset "package.json"
            }
            steps {
                sh 'npm install'
            }
        }
        stage('Build') {
            steps {
                sh '(git rev-parse --short=7 HEAD & git rev-parse --abbrev-ref HEAD) > apps/goal123/public/rnt.txt'
                sh 'npx nx autobuild goal123 --skip-nx-cache'
            }
        }
        stage('Zip'){
            steps {
                dir("dist/apps/goal123"){
                    script {
                        env.commitHash = sh (script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                    }
                    sh 'zip -r mobile-goal123-${commitHash} *'
                    sh 'curl -v -u admin:123456 --upload-file mobile-goal123-${commitHash}.zip http://172.31.28.233:8081/repository/artifacts/Frontend/mobile-goal123-${commitHash}.zip'
                    sh 'echo mobile-goal123-${commitHash}'
                }
            }
        }
    }
}